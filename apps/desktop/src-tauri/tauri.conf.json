{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS Optimizer",
  "version": "1.0.0",
  "identifier": "io.github.networkinfrastructure.dnsoptimizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DNS Optimizer v1.0",
        "width": 1060,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
